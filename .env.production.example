# ADT production environment template
# Copy this file to .env.production on the production host.
# NEVER commit .env.production.

# ---------------------------------------------------------------------------
# Compose / image metadata
# ---------------------------------------------------------------------------

ADT_IMAGE_TAG=local

# ---------------------------------------------------------------------------
# Public frontend build configuration
# These values are embedded in the browser bundle and MUST NOT contain secrets.
# ---------------------------------------------------------------------------

VITE_ADT_API_URL=https://adt.example.com
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY

# ---------------------------------------------------------------------------
# Backend runtime configuration
# ---------------------------------------------------------------------------

ADT_LOG_LEVEL=INFO
ADT_CORS_ORIGINS=https://adt.example.com

# Optional database-pool overrides.
# Leave unset unless capacity profiling justifies changing application defaults.
#
# ADT_API_DATABASE_POOL_MAX_SIZE=
# ADT_PAPER_DATABASE_POOL_MAX_SIZE=
# ADT_MARKET_DATABASE_POOL_MAX_SIZE=

# ---------------------------------------------------------------------------
# Shared Supabase configuration
# ---------------------------------------------------------------------------

SUPABASE_URL=https://PROJECT_REF.supabase.co

# The publishable key is a public client credential, not privileged authority.
# The backend still handles it as sensitive configuration to avoid unnecessary
# logging or accidental disclosure.
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY

# SERVER SECRET.
# Production requires TLS in this PostgreSQL connection string.
SUPABASE_DATABASE_URL=REPLACE_WITH_TLS_POSTGRESQL_CONNECTION_STRING

# ---------------------------------------------------------------------------
# Optional integrations
# Do not populate unless the corresponding feature is intentionally enabled.
# ---------------------------------------------------------------------------

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# Never place any of the following in VITE_* variables:
# - database passwords or SUPABASE_DATABASE_URL
# - service-role / Supabase secret keys
# - Telegram bot tokens
# - private keys
# - exchange API secrets
