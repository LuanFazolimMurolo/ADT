# Supabase — required by the backend; never add real values to this file.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Direct PostgreSQL URL for backend/bootstrap only: postgresql://...
# Production requires sslmode=require (or verify-ca/verify-full).
SUPABASE_DATABASE_URL=

# External services (leave empty for Phase 0)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ADT Configuration
# Required by scripts/bootstrap_admin.py; use an existing auth.users UUID.
ADT_ADMIN_USER_ID=
ADT_ENVIRONMENT=development
ADT_LOG_LEVEL=INFO
# Exact comma-separated origins. Production requires HTTPS and rejects localhost.
ADT_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ADT_DATA_DIR=./data
ADT_MARKET_HTTP_TIMEOUT=10
ADT_MARKET_HTTP_MAX_CONNECTIONS=4
ADT_MARKET_HTTP_RETRIES=3
# Maximum Retry-After that one 429 response may make a call await.
ADT_MARKET_HTTP_MAX_RETRY_AFTER=30
ADT_MARKET_USER_AGENT=ADT-MarketData/0.1
ADT_MARKET_ALLOW_OPEN_CANDLES=false
# Hard safety cap per CLI ingestion; the Binance adapter still pages at 1000.
ADT_MARKET_MAX_FETCH_CANDLES=10000
ADT_MARKET_BACKFILL_CHUNK_CANDLES=1000
ADT_MARKET_BACKFILL_MAX_TOTAL_CANDLES=1000000
ADT_MARKET_INCREMENTAL_OVERLAP_CANDLES=2
ADT_MARKET_JOB_LOCK_TIMEOUT=10
ADT_MARKET_JOB_STALE_AFTER=3600
ADT_MARKET_JOB_MAX_CHUNKS=10000
ADT_MARKET_RESAMPLE_MAX_SOURCE_CANDLES=2000000
ADT_MARKET_RESAMPLE_MAX_GROUPS=500000
ADT_MARKET_RESAMPLE_GAP_POLICY=STRICT
ADT_MARKET_QUALITY_MAX_ISSUES=1000
ADT_MARKET_SNAPSHOT_MAX_PARTITIONS=1200
ADT_MARKET_DERIVED_DIR=derived
ADT_MARKET_MANIFEST_SCHEMA_VERSION=1

# Deterministic local backtesting. ADT_BACKTEST_DIR is relative to ADT_DATA_DIR/market.
ADT_BACKTEST_DIR=backtests
ADT_BACKTEST_MAX_CANDLES=1000000
ADT_BACKTEST_MAX_ORDERS=100000
ADT_BACKTEST_MAX_OPEN_ORDERS=1000
ADT_BACKTEST_MAX_EVENTS=2000000
ADT_BACKTEST_HISTORY_WINDOW=512
ADT_BACKTEST_DEFAULT_MAKER_FEE_BPS=10
ADT_BACKTEST_DEFAULT_TAKER_FEE_BPS=10
ADT_BACKTEST_DEFAULT_SLIPPAGE_BPS=5
ADT_BACKTEST_ENGINE_VERSION=3b-1
ADT_BACKTEST_SCHEMA_VERSION=2

# Backend
ADT_API_HOST=0.0.0.0
ADT_API_PORT=8000

# Frontend — all three public values are required at application startup.
# Never add SUPABASE_SECRET_KEY, database URLs/passwords or admin tokens here
# with a VITE_ prefix.
VITE_ADT_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
