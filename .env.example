# Supabase (keep secrets backend/operations only)
ADT_SUPABASE_URL=
ADT_SUPABASE_SECRET_KEY=
SUPABASE_DATABASE_URL=

# External services (leave empty for Phase 0)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ADT Configuration
# Required by scripts/bootstrap_admin.py; use an existing auth.users UUID.
ADT_ADMIN_USER_ID=
ADT_ENVIRONMENT=development
ADT_LOG_LEVEL=INFO
ADT_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ADT_DATA_DIR=./data

# Backend
ADT_API_HOST=0.0.0.0
ADT_API_PORT=8000

# Frontend
VITE_ADT_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
